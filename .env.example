# =============================================================================
# VARIABLES DE ENTORNO — SISTEMA DE GESTIÓN DE MULTIFUNCIONALES (CONTRATO 27-)
# =============================================================================
# Copia este archivo como `.env.local` en la raíz del proyecto y reemplaza los
# valores de ejemplo con las credenciales reales de tu proyecto en Supabase
# (Project Settings -> API).

# URL pública del proyecto en Supabase (obligatoria)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima (Anon Key) de Supabase para cliente/servidor SSR (obligatoria)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clave publicable alternativa de Supabase (opcional, soportada como fallback de ANON_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu_clave_aqui
